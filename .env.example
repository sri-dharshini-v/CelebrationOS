# CelebrationOS Environment Configuration Template
# COPY this file to '.env' and add your actual API key.
# IMPORTANT: Never commit '.env' to git or share it publicly!

# Port for the Express server (defaults to 3000)
PORT=3000

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model order (comma separated, first tried first).
# When unset, built-in fallback lists are used so one exhausted model does not
# break plan generation or the assistant.
# GEMINI_PLAN_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
# GEMINI_ASSISTANT_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
